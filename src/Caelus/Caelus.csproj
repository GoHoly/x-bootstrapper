<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\x-bootstrapper.ico</ApplicationIcon>
    <RootNamespace>Caelus</RootNamespace>
    <AssemblyName>X Bootstrapper</AssemblyName>
    <Version>2.3.1</Version>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <FileVersion>2.3.1.0</FileVersion>
    <InformationalVersion>2.3.1</InformationalVersion>
    <AssemblyTitle>X Bootstrapper</AssemblyTitle>
    <Company>X Bootstrapper</Company>
    <Product>X Bootstrapper</Product>
    <Description>A bootstrapper for the Octane 2021 revival.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\x-bootstrapper.ico" />
    <Resource Include="Assets\x-mark.png" />
    <Resource Include="Assets\x-banner.png" />
    <!-- This version's notes, shown in the What's new popup after an update (works offline). -->
    <EmbeddedResource Include="..\..\release-notes.md" LogicalName="release-notes.md" Link="release-notes.md" />
  </ItemGroup>
</Project>
