<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\caelus.ico</ApplicationIcon>
    <RootNamespace>Caelus</RootNamespace>
    <AssemblyName>X Bootstrapper</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <AssemblyTitle>X Bootstrapper</AssemblyTitle>
    <Company>X Bootstrapper</Company>
    <Product>X Bootstrapper</Product>
    <Description>A bootstrapper for the Octane 2021 revival.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\caelus.ico" />
    <Resource Include="Assets\x-mark.png" />
    <Resource Include="Assets\x-banner.png" />
  </ItemGroup>
</Project>
