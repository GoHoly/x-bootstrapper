<Window x:Class="Caelus.UI.CustomSkyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom sky"
        Height="640" Width="920"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource WindowFrame}">
        <Grid>
            <Border Style="{DynamicResource AccentStripe}"/>
            <Grid Style="{DynamicResource DialogBody}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource CloseButton}" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click"/>
                    <Border Style="{DynamicResource LogoMark}">
                        <Image Source="{DynamicResource LogoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Custom sky" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource CardText}" Margin="0,2,0,0"
                                   Text="Drop in the six cube faces. Drag the preview to look around — this is how Octane's default sky sees them."/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{DynamicResource Card}" Margin="0" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Faces" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Style="{DynamicResource CardText}" Margin="0,4,0,10"
                                           Text="Click a slot to pick an image, or Import six files named _bk _dn _ft _lf _rt _up."/>
                                <UniformGrid x:Name="FaceGrid" Columns="2" Rows="3"/>
                                <Button Content="Import six images…" Style="{DynamicResource GhostButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch" Click="ImportSix_Click"/>
                                <TextBlock x:Name="StatusText" Style="{DynamicResource CardText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}" Margin="0" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Viewport3D x:Name="SkyView"
                                        ClipToBounds="True"
                                        MouseLeftButtonDown="SkyView_MouseDown"
                                        MouseLeftButtonUp="SkyView_MouseUp"
                                        MouseMove="SkyView_MouseMove"
                                        MouseLeave="SkyView_MouseUp">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="Camera"
                                                       Position="0,0,0"
                                                       LookDirection="0,0,-1"
                                                       UpDirection="0,1,0"
                                                       FieldOfView="80"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D x:Name="SkyModel"/>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <AmbientLight Color="White"/>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                            <TextBlock x:Name="PreviewHint"
                                       Text="Drag to look around"
                                       Style="{DynamicResource CardText}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Margin="12" Opacity="0.7"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{DynamicResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"
                                IsCancel="True"/>
                        <Button x:Name="ApplyButton" Content="Apply sky" Style="{DynamicResource AccentButton}"
                                Click="Apply_Click" IsDefault="True" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource CardText}" VerticalAlignment="Center"
                               Text="Games that set their own Sky keep theirs. Changes show the next time Octane starts."/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
