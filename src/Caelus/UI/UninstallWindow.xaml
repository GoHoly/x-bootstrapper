<Window x:Class="Caelus.UI.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall X Bootstrapper"
        Height="520" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Uninstall X Bootstrapper" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="28,32">
                <StackPanel>
                    <Border Width="200" Height="52" CornerRadius="8" Background="#0B0B0D" ClipToBounds="True" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Image Source="/Assets/x-banner.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Remove X Bootstrapper" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" LineHeight="20"
                               Text="This removes the launcher, shortcuts, and protocol handlers from this account."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="28">
                <TextBlock Text="Uninstall" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16" LineHeight="20"
                           Text="Leave the boxes unchecked to keep mods, settings, and the Octane client. Tick them to wipe this install completely."/>
                <CheckBox x:Name="ClientBox" Content="Also delete downloaded Octane client files"/>
                <CheckBox x:Name="DataBox" Content="Uninstall all contents (mods, presets, settings, and logs)"/>
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button Content="Uninstall" Style="{StaticResource AccentButton}" Background="{DynamicResource DangerBrush}" Click="Uninstall_Click"/>
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
            <Canvas x:Name="SparkleLayer"
                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Panel.ZIndex="40"/>
        </Grid>
    </Border>
</Window>
