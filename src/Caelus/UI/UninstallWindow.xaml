<Window x:Class="Caelus.UI.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall X Bootstrapper"
        Height="520" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource TitleBar}">
                <Grid>
                    <Border Style="{DynamicResource AccentStripe}"/>
                    <TextBlock Text="Uninstall X Bootstrapper" Style="{DynamicResource TitleCaption}"/>
                    <Button Content="✕" Style="{DynamicResource CloseButton}" HorizontalAlignment="Right" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource SidePanel}">
                <StackPanel>
                    <Border Width="200" Height="52" CornerRadius="8" Background="#0B0B0D" ClipToBounds="True" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Image Source="/Assets/x-banner.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Remove X Bootstrapper" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" LineHeight="20"
                               Text="This removes X Bootstrapper, its shortcuts, and its link handlers from this account. Website links go back to the official Octane launcher."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="28">
                <TextBlock Text="Uninstall" Style="{DynamicResource CardTitle}" FontSize="16"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16" LineHeight="20"
                           Text="The Octane client in %LOCALAPPDATA%\Octane is never deleted. Files your mods replaced in it are restored to the originals first."/>
                <CheckBox x:Name="DataBox" Content="Also delete my mods, profiles, settings, and logs"/>
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button Content="Uninstall" Style="{DynamicResource DangerButton}" Click="Uninstall_Click"/>
                    <Button Content="Cancel" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource CardText}" x:Name="StatusText" Margin="0,14,0,0"/>
            </StackPanel>
            <Canvas x:Name="SparkleLayer"
                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Panel.ZIndex="40"/>
        </Grid>
    </Border>
</Window>
