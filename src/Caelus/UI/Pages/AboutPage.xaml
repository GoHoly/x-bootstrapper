<UserControl x:Class="Caelus.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="About" Style="{DynamicResource PageTitle}"/>
        <TextBlock Text="What this is, and what it is not."
                   Style="{DynamicResource PageSubtitle}"/>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <Border Height="72" CornerRadius="6" Background="#0B0B0D" ClipToBounds="True" Margin="0,0,0,14">
                    <Image Source="/Assets/x-banner.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"
                           Text="X Bootstrapper is a local launcher for Octane. It starts the 2021 client, then copies FastFlags and mods onto the version folder."/>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"
                           Text="Not affiliated with Roblox Corporation. Octane is a third-party revival at octane.wtf."/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="octane.wtf" Style="{DynamicResource AccentButton}" Click="Website_Click"/>
                    <Button Content="GitHub" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Click="GitHub_Click"/>
                    <Button Content="Discord" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Click="Discord_Click"/>
                    <Button Content="Logs" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Click="Logs_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock Text="Help and troubleshooting" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource CardText}" Margin="0,4,0,12"
                           Text="Copy logs puts the newest logs, your version and a short settings summary into one zip on your Desktop, ready to attach to a bug report. Anything that looks like a token, ticket, key or join link is removed first."/>
                <WrapPanel>
                    <Button x:Name="CopyLogsButton" Content="Copy logs" Style="{DynamicResource AccentButton}" Click="CopyLogs_Click"/>
                    <Button x:Name="ShowBundleButton" Content="Show in folder" Style="{DynamicResource GhostButton}" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ShowBundle_Click"/>
                </WrapPanel>
                <TextBlock x:Name="CopyLogsStatus" Style="{DynamicResource CardText}" Margin="0,10,0,0" Visibility="Collapsed"/>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="WhatsNewButton" Style="{DynamicResource GhostButton}" Click="WhatsNew_Click"/>
                    <Button Content="Run first-time setup again" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" Click="Setup_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
