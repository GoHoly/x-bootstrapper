<UserControl x:Class="Caelus.UI.Pages.BehaviourPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Behaviour" Style="{DynamicResource PageTitle}"/>
        <TextBlock Text="How X Bootstrapper launches, and whether it hangs around after."
                   Style="{DynamicResource PageSubtitle}"/>

        <!-- Toggles span the card's full width (into its padding) so the whole row takes a click. -->
        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock Text="When you close X Bootstrapper" Style="{DynamicResource CardTitle}"/>
                <CheckBox x:Name="BackgroundBox" Content="Keep running in the background after closing" Margin="-16,10,-16,0" Padding="16,0,16,0"/>
                <TextBlock x:Name="BackgroundHint" Style="{DynamicResource CardText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <CheckBox x:Name="AppUpdatesBox" Content="Auto-update X Bootstrapper from GitHub (or pick a version in Install)" Margin="-16,0,-16,0" Padding="16,0,16,0"/>
                <CheckBox x:Name="ConfirmBox" Content="Ask before launching" Margin="-16,0,-16,0" Padding="16,0,16,0"/>
                <CheckBox x:Name="StayBox" Content="Keep X Bootstrapper open after the client starts" Margin="-16,0,-16,0" Padding="16,0,16,0"/>
                <CheckBox x:Name="TrayBox" Content="Show a tray icon while the game is running (Open settings, Open logs, Exit)" Margin="-16,0,-16,0" Padding="16,0,16,0"/>
                <CheckBox x:Name="AppBetaBox" Content="Launch the Windows App Beta home (Octane App)" Margin="-16,0,-16,0" Padding="16,0,16,0"/>
                <TextBlock x:Name="AppBetaHint" Style="{DynamicResource CardText}" Margin="0,4,0,0"
                           Text="Same as the old Roblox App Beta (--app). Opens the in-client home UI instead of a blank player. Website Play links still join games normally. Octane's current client often lacks App Beta — X Bootstrapper will say so instead of opening a white screen."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
