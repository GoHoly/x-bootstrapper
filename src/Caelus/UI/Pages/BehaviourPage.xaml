<UserControl x:Class="Caelus.UI.Pages.BehaviourPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Behaviour" Style="{DynamicResource PageTitle}"/>
        <TextBlock Text="How X Bootstrapper launches, and whether it hangs around after."
                   Style="{DynamicResource PageSubtitle}"/>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <CheckBox x:Name="AppUpdatesBox" Content="Auto-update X Bootstrapper from GitHub (or pick a version in Install)"/>
                <CheckBox x:Name="ConfirmBox" Content="Ask before launching"/>
                <CheckBox x:Name="StayBox" Content="Keep X Bootstrapper open after the client starts"/>
                <CheckBox x:Name="TrayBox" Content="Show a tray icon while the game is running (Open settings, Open logs, Exit)"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
