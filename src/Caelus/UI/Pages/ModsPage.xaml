<UserControl x:Class="Caelus.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Mods" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Drop in a whole UI pack, or replace one file at a time. X Bootstrapper copies them onto the 2021 client when Octane starts."
                   Style="{StaticResource PageSubtitle}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Import a pack" FontWeight="SemiBold"/>
                <TextBlock Text="Select the pack folder (the one that contains &quot;content&quot;, or the content folder itself), or a .zip of it."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" FontSize="12"/>
                <WrapPanel>
                    <Button Content="Import folder" Style="{StaticResource AccentButton}" Click="ImportFolder_Click"/>
                    <Button Content="Import zip" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ImportZip_Click"/>
                    <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Open_Click"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Single files" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel x:Name="SlotsPanel"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
