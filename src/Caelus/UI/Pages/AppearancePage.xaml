<UserControl x:Class="Caelus.UI.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Appearance" Style="{DynamicResource PageTitle}"/>
        <TextBlock Text="The launcher itself, not the 2021 client. Pick a skin and it applies immediately."
                   Style="{DynamicResource PageSubtitle}"/>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock Text="Theme" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource CardText}" Text="These only change X Bootstrapper. Octane keeps whatever you threw in Mods."
                           Margin="0,4,0,14"/>
                <WrapPanel x:Name="ThemePanel"/>
                <!-- Spans the card's full width (into its padding) so the row takes a click in either style. -->
                <CheckBox x:Name="ClassicStyleBox" Content="Classic style" Margin="-16,4,-16,0" Padding="16,0,16,0"/>
                <TextBlock Style="{DynamicResource CardText}" Margin="0,2,0,0"
                           Text="Brings back the previous X Bootstrapper look (before 2.2) for whichever theme you pick."/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock Text="Launch window" Style="{DynamicResource CardTitle}"/>
                <TextBlock Style="{DynamicResource CardText}" Text="The small dialog while Octane is starting."
                           Margin="0,4,0,10"/>
                <ComboBox x:Name="StyleBox">
                    <ComboBoxItem Content="Match theme"/>
                    <ComboBoxItem Content="2013 gray"/>
                </ComboBox>
                <CheckBox x:Name="SoundsBox" Content="UI sounds" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
