<UserControl x:Class="Caelus.UI.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Install" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Where X Bootstrapper lives, client paths, and which launcher version you want."
                   Style="{StaticResource PageSubtitle}"/>

        <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="UpdateBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="UpdateBannerBody" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UpdateNowButton" Content="Update now" Style="{StaticResource AccentButton}" Click="UpdateNow_Click"/>
                    <Button Content="Not now" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SkipUpdate_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="X Bootstrapper versions" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12"/>
                <CheckBox x:Name="AppUpdatesBox" Content="Auto-update when a new GitHub release is published"/>
                <TextBlock Text="Previous versions" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock x:Name="VersionsStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8" Text="Loading releases…"/>
                <StackPanel x:Name="VersionList"/>
                <Button Content="Refresh" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="RefreshVersions_Click"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Client folder" FontWeight="SemiBold"/>
                <TextBlock Text="Leave empty to auto-detect. Point this at a Versions folder if you already have the 2021 client."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BrowseClient_Click"/>
                    <TextBox x:Name="ClientBox"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Deployment" FontWeight="SemiBold"/>
                <TextBlock Text="X Bootstrapper asks Aisaka for a version manifest, then downloads if one exists."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" FontSize="12"/>
                <TextBlock Text="Website" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="WebsiteBox"/>
                <TextBlock Text="Setup CDN" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                <TextBox x:Name="SetupBox"/>
                <TextBlock Text="Manifest URL" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                <TextBox x:Name="ManifestBox"/>
                <TextBlock Text="Channel" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                <TextBox x:Name="ChannelBox"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Protocols" FontWeight="SemiBold"/>
                <CheckBox x:Name="WebsiteProtocolBox" Content="Handle Play on aisaka.me"/>
                <CheckBox x:Name="RobloxProtocolBox" Content="Also handle roblox-player://  (breaks official Roblox)"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Re-register" Style="{StaticResource GhostButton}" Click="Register_Click"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Uninstall" FontWeight="SemiBold"/>
                <TextBlock Text="Opens the uninstaller. Shortcuts, protocols, and X Bootstrapper are removed if you confirm."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12"/>
                <CheckBox x:Name="WipeBox" Content="Uninstall all contents (mods, presets, settings, logs, client files)"/>
                <Button Content="Uninstall X Bootstrapper" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Uninstall_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
