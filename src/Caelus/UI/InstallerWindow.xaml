<Window x:Class="Caelus.UI.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install X Bootstrapper"
        Height="540" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Install X Bootstrapper" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="28,32">
                <StackPanel>
                    <Border Width="220" Height="56" CornerRadius="8" Background="#0B0B0D" ClipToBounds="True" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <Image Source="/Assets/x-banner.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="X Bootstrapper" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" LineHeight="20"
                               Text="Launches Octane, then copies FastFlags and mods onto the 2021 client."/>
                    <TextBlock Margin="0,24,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                               Text="Not affiliated with Roblox Corporation."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="28,28,28,28">
                <TextBlock Text="Install location" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="LocationBox"/>
                </DockPanel>
                <CheckBox x:Name="ShortcutsBox" Content="Start Menu and desktop shortcuts" IsChecked="True" Margin="0,16,0,0"/>
                <CheckBox x:Name="ProtocolBox" Content="Handle Play on octane.wtf" IsChecked="True"/>
                <CheckBox x:Name="RobloxProtocolBox" Content="Also handle roblox-player://"/>
                <Button Content="Install" Style="{StaticResource AccentButton}" Margin="0,24,0,0" HorizontalAlignment="Left" Click="Install_Click"/>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
            <Canvas x:Name="SparkleLayer"
                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Panel.ZIndex="40"/>
        </Grid>
    </Border>
</Window>
