<Window x:Class="Caelus.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up X Bootstrapper"
        Height="720" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource WindowFrame}">
        <Grid>
            <Border Style="{DynamicResource AccentStripe}"/>
            <Grid Style="{DynamicResource DialogBody}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource CloseButton}" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Skip_Click"/>
                    <Border Style="{DynamicResource LogoMark}">
                        <Image Source="{DynamicResource LogoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to X Bootstrapper" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource CardText}" Margin="0,2,0,0"
                                   Text="Four quick choices. Everything here can be changed later in settings."/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SetupContent">
                        <!-- Toggles span the card's full width (into its padding) so the whole row takes a click. -->
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="1. Look" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Style="{DynamicResource CardText}" Margin="0,4,0,10" Text="Pick a theme. It applies right away."/>
                                <WrapPanel x:Name="ThemePanel"/>
                                <CheckBox x:Name="SetupClassicBox" Content="Classic style (the look before 2.2)" Margin="-16,2,-16,0" Padding="16,0,16,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="2. Discord status" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Style="{DynamicResource CardText}" Margin="0,4,0,10" Text="Whose status Discord shows while Octane runs."/>
                                <ComboBox x:Name="DiscordStatusBox"/>
                                <TextBlock x:Name="DiscordStatusHint" Style="{DynamicResource CardText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="3. Play on octane.wtf" Style="{DynamicResource CardTitle}"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="SetupFixLinksButton" DockPanel.Dock="Right" Content="Fix links" Style="{DynamicResource AccentButton}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Click="FixLinks_Click"/>
                                    <TextBlock x:Name="LinkIcon" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                                    <TextBlock x:Name="LinkStatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="4. When you close it" Style="{DynamicResource CardTitle}"/>
                                <CheckBox x:Name="SetupBackgroundBox" Content="Keep running in the background after closing" Margin="-16,8,-16,0" Padding="16,0,16,0"/>
                                <TextBlock Style="{DynamicResource CardText}" Margin="0,4,0,0"
                                           Text="Off: closing the window exits X Bootstrapper completely (a helper stays only while a game you started through it needs it). On: it stays in the notification area and keeps the website links pointed at X Bootstrapper."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Grid.Row="2" LastChildFill="False">
                    <Button DockPanel.Dock="Right" x:Name="DoneButton" Content="Done" Style="{DynamicResource AccentButton}" Click="Done_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" x:Name="SkipButton" Content="Skip for now" Style="{DynamicResource GhostButton}" Margin="0,0,8,0" Click="Skip_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
