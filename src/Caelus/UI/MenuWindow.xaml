<Window x:Class="Caelus.UI.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Bootstrapper"
        Height="740" Width="1080"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Style="{StaticResource ChromeButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,18,18,8">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#0B0B0D" ClipToBounds="True" HorizontalAlignment="Left">
                            <Image x:Name="BrandMark" Source="/Assets/x-mark.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="BrandTitle" Text="X Bootstrapper" FontWeight="SemiBold" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock x:Name="BrandSub" Text="for Aisaka" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="PLAY" Style="{StaticResource SectionLabel}"/>
                            <RadioButton x:Name="NavMods" Content="Mods" Style="{StaticResource NavButton}" Checked="Nav_Checked" IsChecked="True"/>
                            <RadioButton x:Name="NavFlags" Content="Fast Flags" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}"/>
                            <RadioButton x:Name="NavAppearance" Content="Appearance" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavBehaviour" Content="Behaviour" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavIntegrations" Content="Integrations" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavInstall" Content="Install" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                            <RadioButton x:Name="NavAbout" Content="About" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12,12,12,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button x:Name="LaunchPlayerButton" Content="Launch Aisaka" Style="{StaticResource AccentButton}" Click="LaunchPlayer_Click"/>
                            <Button x:Name="LaunchStudioButton" Content="Studio" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="LaunchStudio_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="32,26,28,28" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost" MaxWidth="760" HorizontalAlignment="Left"/>
            </ScrollViewer>

            <Canvas x:Name="SparkleLayer"
                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Panel.ZIndex="40"/>
        </Grid>
    </Border>
</Window>
