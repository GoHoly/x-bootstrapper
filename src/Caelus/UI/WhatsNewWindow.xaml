<Window x:Class="Caelus.UI.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in X Bootstrapper"
        Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource WindowFrame}">
        <Grid>
            <Border Style="{DynamicResource AccentStripe}"/>
            <Grid Style="{DynamicResource DialogBody}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource CloseButton}" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                    <Border Style="{DynamicResource LogoMark}">
                        <Image Source="/Assets/x-mark.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="What's new" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText" Style="{DynamicResource CardText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,16,0,12" Padding="0">
                    <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" Padding="18,14,14,14">
                        <StackPanel x:Name="NotesPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- Spans the dialog's width (into its margin) so the whole row takes a click. -->
                <CheckBox x:Name="DontShowBox" Grid.Row="2" Content="Don't show what's new after updates"
                          Margin="-16,0,-16,12" Padding="16,0,16,0"/>

                <DockPanel Grid.Row="3" LastChildFill="False">
                    <Button DockPanel.Dock="Right" x:Name="OkButton" Content="Got it" Style="{DynamicResource AccentButton}" Click="Close_Click" IsDefault="True"/>
                    <Button DockPanel.Dock="Right" Content="Release page" Style="{DynamicResource GhostButton}" Margin="0,0,8,0" Click="Release_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
