<Window x:Class="Caelus.UI.BootstrapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Bootstrapper"
        Height="188" Width="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource WindowFrame}">
        <Grid>
            <Border x:Name="AccentBar" Style="{DynamicResource AccentStripe}"/>
            <Grid Style="{DynamicResource DialogBody}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource LogoMark}">
                        <Image x:Name="Logo" Source="{DynamicResource LogoImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="X Bootstrapper" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText" Text="Starting Octane" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="1" Text="Connecting…" VerticalAlignment="Center" FontSize="13"/>
                <ProgressBar x:Name="Progress" Grid.Row="2" IsIndeterminate="True" Margin="0,2,0,12"/>
                <Button Content="Cancel" Style="{DynamicResource GhostButton}" HorizontalAlignment="Right" Grid.Row="3" Click="Cancel_Click"/>
            </Grid>
            <Canvas x:Name="SparkleLayer" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="40"/>
        </Grid>
    </Border>
</Window>
